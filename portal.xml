<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- Clone of this manifest -->
  <project path="portal/manifest" name="manifest" />

  <!-- Portal framework -->
  <project path="portal/engine" name="portal" />
  <project path="portal/event" name="event" />
  <project path="portal/feature" name="feature" />

  <!-- FrameworkOSS portal project builder -->
  <project path="build" name="build">
    <linkfile src="envsetup.sh" dest="envsetup" />
  </project>

  <!-- Sample apps to demonstrate the portal -->
  <project path="apps/examples" name="examples" />

  <!-- Sample features for apps to orchestrate -->
  <project path="features/commands" name="feature_commands" />
  <project path="features/debugger" name="feature_debugger" />
  <project path="features/files" name="feature_files" />
  <project path="features/hellodolly" name="feature_hellodolly" />
  <project path="features/shell" name="feature_shell" />
  <project path="features/stdlib" name="feature_stdlib" />
  <project path="features/telegram" name="feature_telegram" />
  <project path="features/wires" name="feature_wires" />

</manifest>
